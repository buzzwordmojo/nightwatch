{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/monitoring/**",
              "components/onboarding/**",
              "ui_kits/dashboard/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|message|source|time|acknowledged|icon|onAcknowledge|onResolve|key|ref|className|style|children)$/]",
        "message": "<AlertBanner> doesn't accept that prop. Declared props: level, message, source, time, acknowledged, icon, onAcknowledge, onResolve."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:warning|critical)$/]",
        "message": "<AlertBanner> level must be one of 'warning' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioLevelMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|peak|key|ref|className|style|children)$/]",
        "message": "<AudioLevelMeter> doesn't accept that prop. Declared props: level, peak."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|uppercase|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, uppercase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|normal|warning|critical|simulated)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'normal' | 'warning' | 'critical' | 'simulated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|destructive|outline|secondary|ghost|link|success|warning|danger)$/]",
        "message": "<Button> variant must be one of 'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' | 'link' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|icon)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|success|warning|critical)$/]",
        "message": "<Card> variant must be one of 'default' | 'success' | 'warning' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|level|message|startTime|endTime|duration|ongoing|count|icon|key|ref|className|style|children)$/]",
        "message": "<EventRow> doesn't accept that prop. Declared props: source, level, message, startTime, endTime, duration, ongoing, count, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|key|ref|className|style|children)$/]",
        "message": "<FeatureItem> doesn't accept that prop. Declared props: icon, title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|accent|moon|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, variant, accent, moon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NetworkRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:ssid|signal|secured|selected|onSelect|icon|lockIcon|key|ref|className|style|children)$/]",
        "message": "<NetworkRow> doesn't accept that prop. Declared props: ssid, signal, secured, selected, onSelect, icon, lockIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PauseButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:isPaused|remainingMinutes|onPause|onResume|pauseIcon|playIcon|key|ref|className|style|children)$/]",
        "message": "<PauseButton> doesn't accept that prop. Declared props: isPaused, remainingMinutes, onPause, onResume, pauseIcon, playIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|style|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, tone, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|normal|warning|critical)$/]",
        "message": "<Progress> tone must be one of 'accent' | 'normal' | 'warning' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SensorItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|detected|signal|required|optional|icon|key|ref|className|style|children)$/]",
        "message": "<SensorItem> doesn't accept that prop. Declared props: name, description, detected, signal, required, optional, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SensorStatusEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|connected|status|signal|mock|key|ref|className|style|children)$/]",
        "message": "<SensorStatusEntry> doesn't accept that prop. Declared props: key, label, icon, connected, status, signal, mock."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|label|valueLabel|disabled|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, onChange, label, valueLabel, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|size|key|ref|className|style|children)$/]",
        "message": "<StatusIndicator> doesn't accept that prop. Declared props: status, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatusIndicator> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|key|ref|className|style|children)$/]",
        "message": "<StepProgress> doesn't accept that prop. Declared props: current, total."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|type|leadingIcon|trailingIcon|onTrailingClick|error|disabled|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: value, onChange, placeholder, type, leadingIcon, trailingIcon, onTrailingClick, error, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|password)$/]",
        "message": "<TextField> type must be one of 'text' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VitalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|unit|icon|status|isLoading|normalRange|warningRange|criticalRange|showAsText|subtitle|key|ref|className|style|children)$/]",
        "message": "<VitalCard> doesn't accept that prop. Declared props: title, value, unit, icon, status, isLoading, normalRange, warningRange, criticalRange, showAsText, subtitle."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AlertBanner": { "replaces": [] },
      "AudioLevelMeter": { "replaces": [] },
      "Badge": { "replaces": [] },
      "Button": { "replaces": [] },
      "Card": { "replaces": [] },
      "EventRow": { "replaces": [] },
      "FeatureItem": { "replaces": [] },
      "Logo": { "replaces": [] },
      "NetworkRow": { "replaces": [] },
      "PauseButton": { "replaces": [] },
      "Progress": { "replaces": [] },
      "SensorItem": { "replaces": [] },
      "SensorStatusEntry": { "replaces": [] },
      "Slider": { "replaces": [] },
      "StatusIndicator": { "replaces": [] },
      "StepProgress": { "replaces": [] },
      "TextField": { "replaces": [] },
      "VitalCard": { "replaces": [] }
