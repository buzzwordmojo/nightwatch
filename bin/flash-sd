#!/bin/bash
#
# Flash an SD card with Raspberry Pi OS Lite + preload nightwatch project.
#
# Usage:
#   ./bin/flash-sd /dev/sdX
#
# What it does:
#   1. Flashes Raspberry Pi OS Lite (64-bit, Bookworm 2025-05-13) to the SD card
#   2. Enables SSH for headless boot
#   3. Sets default credentials (pi/nightwatch)
#   4. Pre-installs hotspot packages (hostapd, dnsmasq, avahi) for offline setup
#   5. Copies the nightwatch project to /home/pi/nightwatch
#   6. Sets up auto-install service for remaining components
#
# After booting the Pi:
#   - If no WiFi configured: Pi broadcasts "Nightwatch-XXXX" hotspot for setup
#   - Connect to hotspot, configure WiFi via captive portal
#   - Once on network, remaining install completes automatically

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Pi OS image settings (same as VM setup)
PI_OS_VERSION="2025-05-13"
PI_OS_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-${PI_OS_VERSION}/${PI_OS_VERSION}-raspios-bookworm-arm64-lite.img.xz"
# Cache filename carries the version. An unversioned cache silently defeats any
# bump of PI_OS_VERSION — the variable says one thing and the flash does another.
CACHED_IMAGE="${PROJECT_ROOT}/.pi-vm/pi-os-${PI_OS_VERSION}.img.xz"
LEGACY_CACHED_IMAGE="${PROJECT_ROOT}/.pi-vm/pi-os.img.xz"

# WiFi regulatory domain. Raspberry Pi OS keeps the WLAN radio rfkill-blocked
# until a country is set, so without this a flashed card boots with WiFi dead and
# no way in except ethernet. Raspberry Pi Imager normally writes this; we are not
# using the Imager, so we must.
WIFI_COUNTRY="${WIFI_COUNTRY:-US}"

# Default credentials
PI_USER="pi"
PI_PASS="nightwatch"
PI_PASS_HASH='$6$1A/bukiG8A1rKyDJ$uAPHeeDoY2tJA7cemoWETWbJ.1b/6FFS9NrXCJrjcJEU..SeXInyAqFTo5//fHwZUydo1PdrOfsF6ouTy6LDY.'

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step()  { echo -e "${BLUE}[STEP]${NC} $1"; }

# Check for required tools
check_dependencies() {
    local missing=()

    if ! command -v qemu-aarch64-static &>/dev/null; then
        missing+=("qemu-user-static")
    fi

    if [ ! -f /proc/sys/fs/binfmt_misc/qemu-aarch64 ]; then
        missing+=("binfmt-support")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        log_error "Missing dependencies for ARM emulation: ${missing[*]}"
        echo ""
        echo "Install with:"
        echo "  sudo apt install qemu-user-static binfmt-support"
        echo ""
        echo "This is required to pre-install packages into the ARM image."
        exit 1
    fi
}

usage() {
    echo "Usage: $0 <device> [--wifi SSID:PASSWORD] [--restore DIR]"
    echo ""
    echo "  --wifi SSID:PASSWORD   Join this network on first boot, no ethernet needed."
    echo "  --restore DIR          Restore a saved /etc/nightwatch (certs, config.yaml,"
    echo "                         convex.env, wifi.conf). Keeps the existing CA so"
    echo "                         devices do not have to re-trust the dashboard, and"
    echo "                         the Convex admin key so deploys keep working."
    echo "                         WiFi credentials are taken from its wifi.conf when"
    echo "                         --wifi is not given."
    echo ""
    echo "Environment: WIFI_COUNTRY (default US), WIFI_SSID, WIFI_PSK, RESTORE_DIR"
    echo ""
    echo "Examples:"
    echo "  $0 /dev/sdb"
    echo "  $0 /dev/sdb --wifi MyNetwork:hunter2"
    echo "  $0 /dev/sdb --restore ~/backups/nightwatch-pi/etc-nightwatch"
    echo ""
    echo "Use 'lsblk' to find your SD card device."
    exit 1
}

# --- Validation ---

check_dependencies

DEVICE=""
WIFI_SSID="${WIFI_SSID:-}"
WIFI_PSK="${WIFI_PSK:-}"
RESTORE_DIR="${RESTORE_DIR:-}"

while [ $# -gt 0 ]; do
    case "$1" in
        --wifi)
            [ $# -ge 2 ] || { log_error "--wifi needs SSID:PASSWORD"; usage; }
            WIFI_SSID="${2%%:*}"
            WIFI_PSK="${2#*:}"
            if [ "$WIFI_SSID" = "$2" ] || [ -z "$WIFI_SSID" ] || [ -z "$WIFI_PSK" ]; then
                log_error "--wifi must be SSID:PASSWORD"
                exit 1
            fi
            shift 2
            ;;
        --restore)
            [ $# -ge 2 ] || { log_error "--restore needs a directory"; usage; }
            RESTORE_DIR="$2"
            shift 2
            ;;
        -h|--help) usage ;;
        -*) log_error "Unknown option: $1"; usage ;;
        *) DEVICE="$1"; shift ;;
    esac
done

if [ -z "$DEVICE" ]; then
    usage
fi

if [ -n "$RESTORE_DIR" ] && [ ! -d "$RESTORE_DIR" ]; then
    log_error "--restore directory does not exist: $RESTORE_DIR"
    exit 1
fi

# Fall back to the credentials in a restored wifi.conf so one flag does both.
if [ -z "$WIFI_SSID" ] && [ -n "$RESTORE_DIR" ] && [ -r "${RESTORE_DIR}/wifi.conf" ]; then
    WIFI_SSID=$(sed -n 's/^ssid=//p' "${RESTORE_DIR}/wifi.conf" | head -1)
    WIFI_PSK=$(sed -n 's/^password=//p' "${RESTORE_DIR}/wifi.conf" | head -1)
    [ -n "$WIFI_SSID" ] && log_info "WiFi credentials taken from ${RESTORE_DIR}/wifi.conf"
fi

if [ ! -b "$DEVICE" ]; then
    log_error "$DEVICE is not a block device"
    exit 1
fi

# Safety: refuse to write to the running system disk.
# Derive it rather than hardcoding — root is not always /dev/sda.
ROOT_SRC=$(findmnt -no SOURCE / 2>/dev/null || true)
ROOT_DISK=$(lsblk -no PKNAME "$ROOT_SRC" 2>/dev/null | head -1)
if [ -n "$ROOT_DISK" ] && [ "$DEVICE" = "/dev/${ROOT_DISK}" ]; then
    log_error "Refusing to write to $DEVICE — it holds the running root filesystem!"
    exit 1
fi

case "$DEVICE" in
    /dev/nvme*)
        log_error "Refusing to write to $DEVICE — that looks like an internal system disk!"
        exit 1
        ;;
esac

# Refuse fixed disks outright. An SD card in a reader always reports removable=1,
# so this blocks every internal drive without needing to enumerate them.
DEV_BASE=$(basename "$DEVICE")
if [ "$(cat "/sys/block/${DEV_BASE}/removable" 2>/dev/null || echo 1)" = "0" ]; then
    log_error "Refusing to write to $DEVICE — the kernel reports it as non-removable."
    log_error "SD cards report removable=1. Check 'lsblk -o NAME,SIZE,RM,MODEL'."
    log_error "To override deliberately: FLASH_SD_ALLOW_FIXED=1 $0 $DEVICE"
    [ "${FLASH_SD_ALLOW_FIXED:-0}" = "1" ] || exit 1
    log_warn "FLASH_SD_ALLOW_FIXED=1 set — proceeding against a fixed disk."
fi

# Show what we're about to destroy
echo ""
log_warn "This will ERASE ALL DATA on $DEVICE:"
echo ""
lsblk -o NAME,SIZE,MOUNTPOINT,LABEL "$DEVICE" 2>/dev/null || lsblk "$DEVICE"
echo ""
read -p "Type 'yes' to continue: " CONFIRM
if [ "$CONFIRM" != "yes" ]; then
    echo "Aborted."
    exit 1
fi

# --- Step 1: Unmount any mounted partitions ---

log_step "Unmounting partitions..."

unmount_device() {
    local dev="$1"

    for part in $(lsblk -nrp -o NAME "$dev" | tail -n +2); do
        local mnt
        mnt=$(lsblk -nrp -o MOUNTPOINT "$part" 2>/dev/null | head -1)
        [ -z "$mnt" ] && continue

        # Try udisksctl first (handles auto-mounted drives cleanly)
        if command -v udisksctl &>/dev/null; then
            udisksctl unmount -b "$part" 2>/dev/null && log_info "Unmounted $part" && continue
        fi

        # Fall back to regular umount
        sudo umount "$part" 2>/dev/null && log_info "Unmounted $part" && continue

        # Kill anything holding it open, then lazy unmount
        log_warn "$part is busy, forcing unmount..."
        sudo fuser -km "$mnt" 2>/dev/null || true
        sleep 1
        sudo umount -l "$part" 2>/dev/null && log_info "Lazy-unmounted $part" && continue

        log_error "Failed to unmount $part"
        exit 1
    done
}

unmount_device "$DEVICE"

# Verify nothing is still mounted
STILL_MOUNTED=$(lsblk -nrp -o NAME,MOUNTPOINT "$DEVICE" | awk '$2 != "" {print $1}')
if [ -n "$STILL_MOUNTED" ]; then
    log_error "Partitions still mounted: $STILL_MOUNTED"
    log_error "Close any file managers or terminals using the SD card and try again."
    exit 1
fi

log_info "All partitions unmounted"

# --- Step 2: Get the image ---

log_step "Preparing Raspberry Pi OS Lite image..."

# Warn loudly if an old unversioned cache is lying around — it is NOT used.
if [ -f "$LEGACY_CACHED_IMAGE" ]; then
    log_warn "Ignoring unversioned cache $LEGACY_CACHED_IMAGE (version unknown)."
    log_warn "Delete it once you are sure nothing else needs it."
fi

if [ ! -f "$CACHED_IMAGE" ]; then
    log_info "Downloading Raspberry Pi OS Lite ${PI_OS_VERSION}..."
    mkdir -p "$(dirname "$CACHED_IMAGE")"
    wget -O "${CACHED_IMAGE}.part" "$PI_OS_URL" || {
        log_error "Download failed"
        rm -f "${CACHED_IMAGE}.part"
        exit 1
    }
    mv "${CACHED_IMAGE}.part" "$CACHED_IMAGE"
fi

log_info "Using image: $CACHED_IMAGE"

# Verify against the checksum Raspberry Pi publishes alongside the image.
# Flashing a corrupt image produces a Pi that fails in confusing ways hours later.
log_step "Verifying image checksum..."
EXPECTED_SHA=$(wget -qO- "${PI_OS_URL}.sha256" | awk '{print $1}')
if [ -z "$EXPECTED_SHA" ]; then
    log_warn "Could not fetch published checksum (offline?) — skipping verification."
else
    ACTUAL_SHA=$(sha256sum "$CACHED_IMAGE" | awk '{print $1}')
    if [ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]; then
        log_error "Checksum MISMATCH for $CACHED_IMAGE"
        log_error "  expected: $EXPECTED_SHA"
        log_error "  actual:   $ACTUAL_SHA"
        log_error "Refusing to flash. Delete the cached file and re-run to re-download."
        exit 1
    fi
    log_info "Checksum verified (sha256 ${ACTUAL_SHA:0:16}...)"
fi

IMAGE_SOURCE="$CACHED_IMAGE"

# --- Step 3: Flash ---

log_step "Flashing $DEVICE (this takes a few minutes)..."
xzcat "$IMAGE_SOURCE" | sudo dd of="$DEVICE" bs=4M conv=fsync status=progress
sudo sync
log_info "Flash complete"

# --- Step 4: Expand rootfs to fill the card ---

log_step "Expanding root partition to fill the card..."
# Get the partition name (sdb2 or mmcblk0p2)
sleep 2  # let kernel re-read partition table
sudo partprobe "$DEVICE" 2>/dev/null || true
sleep 1

# Find partition naming scheme
if [[ "$DEVICE" == *"mmcblk"* ]]; then
    BOOT_PART="${DEVICE}p1"
    ROOT_PART="${DEVICE}p2"
else
    BOOT_PART="${DEVICE}1"
    ROOT_PART="${DEVICE}2"
fi

# Grow partition 2 to fill remaining space (yes to suppress "partition in use" warning)
echo yes | sudo parted ---pretend-input-tty "$DEVICE" resizepart 2 100%
sudo e2fsck -f -y "$ROOT_PART" || true
sudo resize2fs "$ROOT_PART"
log_info "Root partition expanded"

# --- Step 5: Mount and configure ---

log_step "Configuring for headless boot..."

BOOT_MNT=$(mktemp -d)
ROOT_MNT=$(mktemp -d)

sudo mount "$BOOT_PART" "$BOOT_MNT"
sudo mount "$ROOT_PART" "$ROOT_MNT"

# Enable SSH
sudo touch "$BOOT_MNT/ssh"
log_info "SSH enabled"

# Set default credentials
echo "${PI_USER}:${PI_PASS_HASH}" | sudo tee "$BOOT_MNT/userconf.txt" > /dev/null
log_info "User configured (${PI_USER}:${PI_PASS})"

# Set the WiFi country in the kernel command line, exactly as
# `raspi-config nonint do_wifi_country` does. Setting it before the first boot
# means the regulatory domain is known at kernel init and the radio is never
# blocked, so there is no chicken-and-egg where fixing WiFi requires WiFi.
if [ -f "$BOOT_MNT/cmdline.txt" ]; then
    sudo sed -i \
        -e "s/\s*cfg80211.ieee80211_regdom=\S*//" \
        -e "s/\(.*\)/\1 cfg80211.ieee80211_regdom=${WIFI_COUNTRY}/" \
        "$BOOT_MNT/cmdline.txt"
    log_info "WiFi country set to ${WIFI_COUNTRY} (radio would stay rfkill-blocked without it)"
else
    log_warn "No cmdline.txt on the boot partition - WiFi may come up rfkill-blocked."
fi

# Set hostname to nightwatch (so it broadcasts nightwatch.local via mDNS)
echo "nightwatch" | sudo tee "$ROOT_MNT/etc/hostname" > /dev/null
sudo sed -i 's/127\.0\.1\.1.*raspberrypi/127.0.1.1\tnightwatch/' "$ROOT_MNT/etc/hosts"
log_info "Hostname set to nightwatch (nightwatch.local)"

# --- Step 6: Pre-install hotspot packages ---

log_step "Pre-installing hotspot packages (hostapd, dnsmasq, avahi)..."

# Copy QEMU binary for ARM emulation
sudo cp /usr/bin/qemu-aarch64-static "$ROOT_MNT/usr/bin/"

# Run apt inside the ARM rootfs using QEMU emulation
sudo chroot "$ROOT_MNT" /bin/bash -c '
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8

    # Update package lists
    apt-get update -qq

    # Install hotspot dependencies
    apt-get install -y -qq \
        hostapd \
        dnsmasq \
        avahi-daemon \
        python3 \
        python3-pip \
        python3-venv

    # Disable hostapd/dnsmasq services (nightwatch manages them)
    systemctl disable hostapd 2>/dev/null || true
    systemctl disable dnsmasq 2>/dev/null || true

    # Enable avahi for mDNS
    systemctl enable avahi-daemon

    # Create nightwatch user and directories
    useradd --system --home-dir /opt/nightwatch --shell /bin/false nightwatch 2>/dev/null || true
    usermod -aG dialout,audio,netdev nightwatch 2>/dev/null || true
    mkdir -p /opt/nightwatch /etc/nightwatch /var/lib/nightwatch /var/log/nightwatch
    chown -R nightwatch:nightwatch /opt/nightwatch /var/lib/nightwatch /var/log/nightwatch

    # Clean up apt cache to save space
    apt-get clean
    rm -rf /var/lib/apt/lists/*
'

# Remove QEMU binary (not needed at runtime)
sudo rm -f "$ROOT_MNT/usr/bin/qemu-aarch64-static"

log_info "Hotspot packages pre-installed"

# --- Step 7: Copy nightwatch project (needed before pip install) ---

log_step "Copying nightwatch project..."

DEST="${ROOT_MNT}/home/pi/nightwatch"
sudo mkdir -p "$DEST"

# Copy project files, excluding dev/build artifacts
sudo rsync -a --info=progress2 \
    --exclude '.git' \
    --exclude '.pi-vm' \
    --exclude 'node_modules' \
    --exclude '.next' \
    --exclude '__pycache__' \
    --exclude '*.pyc' \
    --exclude '.venv' \
    --exclude 'venv' \
    --exclude '.env' \
    "${PROJECT_ROOT}/" "$DEST/"

# Fix ownership (pi user is UID 1000 on Raspberry Pi OS)
sudo chown -R 1000:1000 "$DEST"

log_info "Project copied to /home/pi/nightwatch"

# --- Step 7b: Preseed WiFi and restore saved configuration ---
# Both happen here: after the chroot created the nightwatch user and
# /etc/nightwatch, and BEFORE the venv install copies in a default config.yaml
# (it is guarded by `if [ ! -f ]`, so a restored file survives).

NW_UID=$(awk -F: '$1=="nightwatch"{print $3}' "$ROOT_MNT/etc/passwd")
NW_GID=$(awk -F: '$1=="nightwatch"{print $4}' "$ROOT_MNT/etc/passwd")

if [ -n "$WIFI_SSID" ]; then
    log_step "Preseeding WiFi network '${WIFI_SSID}'..."
    # A NetworkManager profile brings the network up at boot, independent of the
    # nightwatch service. If the app fails to start there is still SSH.
    nm_dir="$ROOT_MNT/etc/NetworkManager/system-connections"
    sudo mkdir -p "$nm_dir"
    uuid=$(cat /proc/sys/kernel/random/uuid)
    sudo tee "${nm_dir}/${WIFI_SSID}.nmconnection" > /dev/null <<NMEOF
[connection]
id=${WIFI_SSID}
uuid=${uuid}
type=wifi
autoconnect=true
autoconnect-priority=100

[wifi]
mode=infrastructure
ssid=${WIFI_SSID}

[wifi-security]
key-mgmt=wpa-psk
psk=${WIFI_PSK}

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=default
NMEOF
    sudo chown root:root "${nm_dir}/${WIFI_SSID}.nmconnection"
    sudo chmod 600 "${nm_dir}/${WIFI_SSID}.nmconnection"
    log_info "WiFi profile written - the card will join '${WIFI_SSID}' with no ethernet"
else
    log_warn "No WiFi credentials given (--wifi). The card will boot into hotspot"
    log_warn "setup mode, which needs a phone or ethernet to complete."
fi

if [ -n "$RESTORE_DIR" ]; then
    log_step "Restoring configuration from ${RESTORE_DIR}..."
    sudo mkdir -p "$ROOT_MNT/etc/nightwatch"
    for f in config.yaml convex.env wifi.conf .configured; do
        [ -e "${RESTORE_DIR}/${f}" ] && sudo cp "${RESTORE_DIR}/${f}" "$ROOT_MNT/etc/nightwatch/${f}"
    done
    [ -d "${RESTORE_DIR}/certs" ] && sudo cp -a "${RESTORE_DIR}/certs" "$ROOT_MNT/etc/nightwatch/"

    # Permissions mirror install.sh: config readable by the service group,
    # certs owned by the service account. Run the globs as root - they expand in
    # the calling shell, which cannot read a 750 root-owned directory.
    sudo chown -R "root:${NW_GID}" "$ROOT_MNT/etc/nightwatch"
    sudo chmod 750 "$ROOT_MNT/etc/nightwatch"
    sudo sh -c "
        chmod 640 '$ROOT_MNT'/etc/nightwatch/config.yaml '$ROOT_MNT'/etc/nightwatch/convex.env \
                  '$ROOT_MNT'/etc/nightwatch/wifi.conf '$ROOT_MNT'/etc/nightwatch/.configured 2>/dev/null
        if [ -d '$ROOT_MNT/etc/nightwatch/certs' ]; then
            chmod 750 '$ROOT_MNT'/etc/nightwatch/certs
            chown ${NW_UID}:${NW_GID} '$ROOT_MNT'/etc/nightwatch/certs/*
            chmod 600 '$ROOT_MNT'/etc/nightwatch/certs/*.key* 2>/dev/null
            chmod 644 '$ROOT_MNT'/etc/nightwatch/certs/*.crt* 2>/dev/null
        fi
    "
    log_info "Configuration restored (existing CA and Convex admin key preserved)"
fi

# --- Step 8: Install nightwatch Python package ---

log_step "Installing nightwatch Python package..."

# Need QEMU again for pip install
sudo cp /usr/bin/qemu-aarch64-static "$ROOT_MNT/usr/bin/"

sudo chroot "$ROOT_MNT" /bin/bash -c '
    export DEBIAN_FRONTEND=noninteractive

    # Install additional build dependencies
    apt-get update -qq
    apt-get install -y -qq \
        python3-dev \
        libzmq3-dev \
        libasound2-dev \
        portaudio19-dev \
        libsndfile1

    # Create venv and install nightwatch
    python3 -m venv /opt/nightwatch/venv
    /opt/nightwatch/venv/bin/pip install --upgrade pip wheel

    # Install nightwatch from local source (non-editable for ProtectHome compatibility)
    cd /home/pi/nightwatch
    /opt/nightwatch/venv/bin/pip install .

    # Copy default config if not exists
    if [ ! -f /etc/nightwatch/config.yaml ]; then
        cp /home/pi/nightwatch/config/default.yaml /etc/nightwatch/config.yaml
        chmod 640 /etc/nightwatch/config.yaml
    fi

    # Fix ownership
    chown -R nightwatch:nightwatch /opt/nightwatch /var/lib/nightwatch /var/log/nightwatch

    # Clean up apt cache
    apt-get clean
    rm -rf /var/lib/apt/lists/*
'

sudo rm -f "$ROOT_MNT/usr/bin/qemu-aarch64-static"

log_info "Nightwatch package installed"

# --- Step 9: Install systemd services ---

log_step "Installing systemd services..."

# Main nightwatch service
sudo tee "$ROOT_MNT/etc/systemd/system/nightwatch.service" > /dev/null << 'EOF'
[Unit]
Description=Nightwatch Epilepsy Monitor
After=network.target

[Service]
Type=simple
User=nightwatch
Group=nightwatch
WorkingDirectory=/opt/nightwatch
Environment="PATH=/opt/nightwatch/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/nightwatch/venv/bin/python -m nightwatch
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nightwatch /var/log/nightwatch /etc/nightwatch /var/lib/misc
PrivateTmp=true

# Network capabilities for hotspot management
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
EOF

# Create dnsmasq lease file owned by the nightwatch service account.
# Read the ids out of the image rather than hardcoding — useradd --system picks
# from a descending range, so the nightwatch uid/gid are not stable across builds.
NW_UID=$(awk -F: '$1=="nightwatch"{print $3}' "$ROOT_MNT/etc/passwd")
NW_GID=$(awk -F: '$1=="nightwatch"{print $4}' "$ROOT_MNT/etc/passwd")
if [ -z "$NW_UID" ] || [ -z "$NW_GID" ]; then
    log_error "nightwatch user missing from the image — the chroot stage did not complete."
    exit 1
fi
sudo touch "$ROOT_MNT/var/lib/misc/dnsmasq.leases"
sudo chown "${NW_UID}:${NW_GID}" "$ROOT_MNT/var/lib/misc/dnsmasq.leases"
log_info "dnsmasq lease file owned by nightwatch (${NW_UID}:${NW_GID})"

# Enable nightwatch service
sudo mkdir -p "$ROOT_MNT/etc/systemd/system/multi-user.target.wants"
sudo ln -sf /etc/systemd/system/nightwatch.service \
    "$ROOT_MNT/etc/systemd/system/multi-user.target.wants/nightwatch.service"

log_info "Systemd services installed"

# Add a helpful MOTD
sudo tee "$ROOT_MNT/etc/motd" > /dev/null << 'EOF'

  _   _ _       _     _               _       _
 | \ | (_) __ _| |__ | |___      ____ | |_ ___| |__
 |  \| | |/ _` | '_ \| __\ \ /\ / / _` | __/ __| '_ \
 | |\  | | (_| | | | | |_ \ V  V / (_| | || (__| | | |
 |_| \_|_|\__, |_| |_|\__| \_/\_/ \__,_|\__\___|_| |_|
          |___/

 Nightwatch is pre-installed and starts automatically!

 If WiFi is not configured, look for hotspot: Nightwatch-XXXX
 Connect to configure WiFi, then monitoring begins automatically.

 Commands:
   sudo journalctl -u nightwatch -f    # View logs
   sudo systemctl status nightwatch    # Check status

EOF

# --- Done ---

log_step "Cleaning up..."
sudo umount "$BOOT_MNT"
sudo umount "$ROOT_MNT"
rmdir "$BOOT_MNT" "$ROOT_MNT"
sudo sync

echo ""
echo "=========================================="
echo "  SD Card Ready!"
echo "=========================================="
echo ""
echo "What happens on boot:"
echo "  1. If WiFi not configured → broadcasts 'Nightwatch-XXXX' hotspot"
echo "  2. Connect to hotspot → captive portal for WiFi setup"
echo "  3. After WiFi configured → nightwatch starts monitoring"
echo ""
echo "Or connect via ethernet and SSH:"
echo "  ssh pi@nightwatch.local"
echo "  Password: ${PI_PASS}"
echo ""
echo "Dashboard: http://nightwatch.local:5000"
echo ""
